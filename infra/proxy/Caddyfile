# TLS in front of Foresentry. One origin serves the dashboard and the API, so the
# browser never talks plain HTTP and no cross-origin rules are needed.
#
# SITE_ADDRESS=localhost (default): Caddy issues a certificate from its own
#   local authority. Browsers warn until that authority is trusted on the machine.
# SITE_ADDRESS=risk.example.com: Caddy obtains and renews a public certificate
#   automatically. Ports 80 and 443 must be reachable from the internet.
{$SITE_ADDRESS:localhost} {
	# Compress pages and JSON, never the live stream: a compressor holds small events back
	# until its buffer fills, so the console would see nothing and keep reconnecting.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html* text/css* text/plain* text/javascript* application/javascript* application/json* image/svg+xml*
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	@api path /v1/* /health/* /docs /openapi.json
	handle @api {
		# API_UPSTREAM may list several APIs ("api:8000 api-2:8000", see docker-compose.ha.yml).
		reverse_proxy {$API_UPSTREAM:api:8000} {
			# The live stream is Server-Sent Events: pass every chunk through at once.
			flush_interval -1
			lb_policy round_robin
			# A request that cannot reach one API is retried on another for up to 5 s.
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 10s
			# Ask each API every 2 s whether its process answers; stop using one that does not.
			# (/health/live, not /health/ready: a scorer outage must not take both APIs out.)
			health_uri /health/live
			health_interval 2s
			health_timeout 2s
		}
	}

	# Prometheus metrics stay inside the network; they are not published.
	handle /metrics {
		respond 404
	}

	handle {
		reverse_proxy {$DASHBOARD_UPSTREAM:dashboard:80}
	}
}
