# DEMO environment: synthetic transactions and controlled fraud scenarios only.
# Copy to .env to use it:  cp .env.demo .env
ENVIRONMENT=demo
# spark  = every event goes through Spark Structured Streaming before scoring (full workflow)
# direct = scorer reads the raw topic; lower latency, lighter on RAM
PIPELINE_MODE=spark
KAFKA_BOOTSTRAP=kafka:9092
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=fraud
DATABASE_URL=postgresql://fraud:fraud@postgres:5432/vyrox_demo
MODEL_DIR=models/current
API_KEYS=dev-key
WEBHOOK_SECRET=demo-webhook-secret
# First administrator, created at start-up. Demo only: production refuses to start with this password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=vyrox-demo-admin
# Platform operator who manages organisations. Demo only: production refuses this password.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=foresentry-demo-super
# Organisation that payment-gateway connectors and the generic webhook deliver to.
CONNECTOR_ORG=demo
RATE_LIMIT_PER_MINUTE=6000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
GENERATOR_RATE=50
# Demo only: production refuses to start with this key.
SECRET_KEY=vyrox-demo-secret-key

# Payment-gateway webhooks (docs/INTEGRATION.md 2a). Empty = connector off.
RAZORPAY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
CONNECTOR_CURRENCIES=INR
# Slack, Teams or other incoming webhook for operational alerts. Empty = off.
ALERT_WEBHOOK_URL=
