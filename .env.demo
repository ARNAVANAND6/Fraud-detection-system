# DEMO environment: synthetic transactions and controlled fraud scenarios only.
# Copy to .env to use it:  cp .env.demo .env
ENVIRONMENT=demo
# spark  = every event goes through Spark Structured Streaming before scoring (full workflow)
# direct = scorer reads the raw topic; lower latency, lighter on RAM
PIPELINE_MODE=spark
KAFKA_BOOTSTRAP=kafka:9092
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=fraud
DATABASE_URL=postgresql://fraud:fraud@postgres:5432/vyrox_demo
MODEL_DIR=models/current
API_KEYS=dev-key
WEBHOOK_SECRET=demo-webhook-secret
RATE_LIMIT_PER_MINUTE=6000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
GENERATOR_RATE=50
