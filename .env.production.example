# PRODUCTION environment: only authorised real transaction integrations.
# It uses its own topics (production.*), database and Redis DB, so it never
# shares data with the demo environment. The services refuse to start if the
# demo API key or demo webhook secret is still in use, the synthetic
# generator refuses to run, and simulated events are rejected.
#
# Foresentry has no bundled bank, UPI or card-network integration. Real data can
# only arrive through an authorised provider you connect yourself.
ENVIRONMENT=production
PIPELINE_MODE=spark
KAFKA_BOOTSTRAP=kafka:9092
REDIS_URL=redis://redis:6379/1
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://fraud:change-me@postgres:5432/vyrox_production
MODEL_DIR=models/current
API_KEYS=generate-a-long-random-key
WEBHOOK_SECRET=generate-a-long-random-secret
# First administrator, created at start-up if that username does not exist yet.
# Sign in, add named accounts for each person, then change this password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=generate-a-long-random-password
# Platform operator who creates and suspends organisations and changes the risk settings.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=generate-another-long-random-password
CONNECTOR_ORG=demo
RATE_LIMIT_PER_MINUTE=6000
CORS_ORIGINS=https://your-dashboard.example.com
# Encrypts two-factor secrets at rest: at least 32 random characters. Keep it: changing it
# invalidates every enrolled authenticator.
SECRET_KEY=generate-at-least-32-random-characters
# Make two-factor sign-in compulsory for these roles.
MFA_REQUIRED_ROLES=ADMIN,ANALYST
# Single sign-on (OpenID Connect). Register OIDC_REDIRECT_URL with your provider.
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Microsoft
# OIDC_REDIRECT_URL=https://risk.example.com/v1/auth/sso/callback
# DASHBOARD_URL=https://risk.example.com
# OIDC_ALLOWED_DOMAINS=yourbank.example
# OIDC_DEFAULT_ROLE=VIEWER

# Payment-gateway webhooks (docs/INTEGRATION.md 2a). Empty = connector off.
RAZORPAY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
CONNECTOR_CURRENCIES=INR
# Slack, Teams or other incoming webhook for operational alerts. Empty = off.
ALERT_WEBHOOK_URL=
# Redis memory for feature history: about 120 bytes per payment in the last 25 hours (docs/DEPLOYMENT.md).
REDIS_MAXMEMORY=4gb
