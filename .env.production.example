# PRODUCTION environment: only authorised real transaction integrations.
# It uses its own topics (production.*), database and Redis DB, so it never
# shares data with the demo environment. The services refuse to start if the
# demo API key or demo webhook secret is still in use, the synthetic
# generator refuses to run, and simulated events are rejected.
#
# VYROX has no bundled bank, UPI or card-network integration. Real data can
# only arrive through an authorised provider you connect yourself.
ENVIRONMENT=production
PIPELINE_MODE=spark
KAFKA_BOOTSTRAP=kafka:9092
REDIS_URL=redis://redis:6379/1
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://fraud:change-me@postgres:5432/vyrox_production
MODEL_DIR=models/current
API_KEYS=generate-a-long-random-key
WEBHOOK_SECRET=generate-a-long-random-secret
RATE_LIMIT_PER_MINUTE=6000
CORS_ORIGINS=https://your-dashboard.example.com
